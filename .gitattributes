# Normalise line endings: LF in the repository and in the working tree
# (the code runs in Linux containers; Windows tools handle LF fine).
* text=auto eol=lf

# Binary files
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.gif  binary
*.ico  binary
*.docx binary
*.pdf  binary
*.mp4  binary
*.pth  binary
*.pt   binary
*.pkl  binary
